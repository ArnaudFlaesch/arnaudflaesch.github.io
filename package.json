{
  "name": "arnaudflaesch.github.io",
  "author": "Arnaud Flaesch",
  "version": "1.0.0",
  "description": "Site web personnel",
  "homepage": "https://arnaudflaesch.github.io",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('.next', { recursive: true, force: true }); fs.rmSync('out', { recursive: true, force: true })\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint:md": "markdownlint **/*.md",
    "lint:md:fix": "npm run lint:md -- --fix",
    "eslint": "eslint .",
    "eslint:fix": "npm run eslint -- --fix",
    "lint:styles": "stylelint \"./**/*.{css,scss,sass}\" ",
    "lint:styles:fix": "npm run lint:styles -- --fix ",
    "lint:styles:report": "npm run lint:styles -- --formatter json --output-file ./styleLintReport.json",
    "code:check": "prettier . --check",
    "code:format": "prettier . --write",
    "cy:open": "cypress open",
    "cy:run": "cypress run --headless --browser chrome",
    "cy:verify": "npx cypress verify"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "date-fns": "4.1.0",
    "gray-matter": "4.0.3",
    "marked": "15.0.7",
    "next": "15.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rss": "1.2.2",
    "sass": "1.85.0"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@types/rss": "0.0.32",
    "cypress": "14.1.0",
    "cypress-multi-reporters": "2.0.5",
    "eslint": "9.20.1",
    "eslint-config-next": "15.2.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-cypress": "4.1.0",
    "globals": "15.15.0",
    "markdownlint-cli": "0.44.0",
    "mochawesome": "7.1.3",
    "mochawesome-merge": "4.3.0",
    "mochawesome-report-generator": "6.2.0",
    "prettier": "3.5.1",
    "stylelint": "16.14.1",
    "stylelint-config-standard-scss": "14.0.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.1"
  }
}

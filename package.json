{
  "name": "arnaudflaesch.github.io",
  "author": "Arnaud Flaesch",
  "version": "1.0.0",
  "description": "Site web personnel",
  "homepage": "https://arnaudflaesch.github.io",
  "private": true,
  "engines": {
    "node": "26.x",
    "npm": "11.x || 12.x"
  },
  "scripts": {
    "clean": "node -e \"for (const dir of ['.next', 'out']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint:md": "markdownlint **/*.md",
    "lint:md:fix": "npm run lint:md -- --fix",
    "eslint": "eslint .",
    "eslint:fix": "npm run eslint -- --fix",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:styles:fix": "npm run lint:styles -- --fix",
    "lint:styles:report": "npm run lint:styles -- --formatter json --output-file ./styleLintReport.json",
    "code:check": "prettier . --check",
    "code:format": "prettier . --write",
    "cy:open": "cypress open",
    "cy:run": "cypress run --headless --browser chrome",
    "cy:verify": "cypress verify"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "gray-matter": "4.0.3",
    "marked": "18.1.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rss": "1.2.2",
    "sass": "1.107.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/rss": "0.0.32",
    "cypress": "16.2.1",
    "cypress-multi-reporters": "2.0.5",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "7.0.2",
    "globals": "17.13.0",
    "markdownlint-cli": "0.50.0",
    "mochawesome": "8.1.1",
    "mochawesome-merge": "5.1.1",
    "mochawesome-report-generator": "6.3.2",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  }
}
